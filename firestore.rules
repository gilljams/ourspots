rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Hjälpfunktion för att kolla om användare är admin
    function isAdmin() {
      return request.auth != null && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
    
    // Check if user's email is in the sharedWithEmails array
    function isInSharedList(objectData) {
      return request.auth != null && 
             objectData.sharedWithEmails != null &&
             request.auth.token.email.lower() in objectData.sharedWithEmails;
    }
    
    // Check if user has editor role - uses editorEmails array for reliable checking
    // (shares map keys use _DOT_ escaping which doesn't work with email.lower())
    function hasEditorAccess(objectData) {
      return request.auth != null && 
             objectData.editorEmails != null &&
             request.auth.token.email.lower() in objectData.editorEmails;
    }
    
    // Check if user has ANY accepted share access (viewer or editor)
    // Uses acceptedShareEmails array since shares keys use _DOT_ escaping
    function hasAcceptedShareAccess(objectData) {
      return request.auth != null && 
             objectData.acceptedShareEmails != null &&
             request.auth.token.email.lower() in objectData.acceptedShareEmails;
    }
    
    match /users/{userId} {
      // Users can read/write their own document
      allow read, write: if request.auth != null && request.auth.uid == userId;
      // Allow reading other users for sharing features
      allow read: if request.auth != null;
      // Admin can update any user (for blocking, admin toggle, etc.)
      allow update: if isAdmin();
    }
    
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /settings/{settingId} {
      // Anyone can read settings
      allow read: if request.auth != null;
      // Only admin can write settings
      allow write: if isAdmin();
    }
    
    match /objects/{objectId} {
      // Read access: Owner, in sharedWithEmails array (includes pending), Admin, or Demo objects (anyone logged in)
      // Note: Paused shares are still in sharedWithEmails but removed from acceptedShareEmails
      // The UI handles hiding paused content - Firestore rules allow read for pending invitations
      allow read: if request.auth != null && (
                    resource.data.isDemo == true ||                // Demo objects (anyone logged in)
                    resource.data.ownerId == request.auth.uid ||  // Owner
                    isInSharedList(resource.data) ||               // In shared list (includes pending)
                    isAdmin()                                      // Admin
                  );
      
      // Create: Anyone logged in
      allow create: if request.auth != null;
      
      // Update: Owner, Editor role (accepted), or Admin
      // Also allow shared users to update their own share status (accept/decline) or leave sharing
      // Also allow any accepted share user to update blocks (checklist/todo)
      // Also allow any logged-in user to update blocks on demo objects (interactive demo)
      allow update: if request.auth != null && (
                       request.auth.uid == resource.data.ownerId ||  // Owner
                       isAdmin() ||                                   // Admin
                       hasEditorAccess(resource.data) ||              // Editor role (via editorEmails array)
                       // Allow any shared user to update shares, sharedWithEmails, acceptedShareEmails, editorEmails (accept/decline/leave)
                       (isInSharedList(resource.data) &&
                        request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['shares', 'sharedWithEmails', 'acceptedShareEmails', 'editorEmails'])) ||
                       // Allow any accepted shared user to update blocks and updatedAt (checklist/todo)
                       (hasAcceptedShareAccess(resource.data) &&
                        request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['blocks', 'updatedAt'])) ||
                       // Allow any logged-in user to update blocks on demo objects (interactive demo)
                       (resource.data.isDemo == true &&
                        request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['blocks', 'updatedAt']))
                     );
      
      // Delete: Owner or Admin only
      allow delete: if request.auth != null && 
                       (request.auth.uid == resource.data.ownerId || isAdmin());
    }
  }
}
