rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Hjälpfunktion för att kolla om användare är admin
    function isAdmin() {
      return request.auth != null && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
    
    // Check if user's email is in the sharedWithEmails array
    function isInSharedList(objectData) {
      return request.auth != null && 
             objectData.sharedWithEmails != null &&
             request.auth.token.email.lower() in objectData.sharedWithEmails;
    }
    
    // Check if user has ACCEPTED share access (for editing) - needs shares map
    function hasAcceptedEditorAccess(objectData) {
      return request.auth != null && 
             objectData.shares != null &&
             request.auth.token.email.lower() in objectData.shares &&
             objectData.shares[request.auth.token.email.lower()].status == 'accepted' &&
             objectData.shares[request.auth.token.email.lower()].role == 'editor';
    }
    
    // Check if user has ANY accepted share access (viewer or editor)
    function hasAcceptedShareAccess(objectData) {
      return request.auth != null && 
             objectData.shares != null &&
             request.auth.token.email.lower() in objectData.shares &&
             objectData.shares[request.auth.token.email.lower()].status == 'accepted';
    }
    
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null; // Allow reading other users for sharing
    }
    
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /objects/{objectId} {
      // Read access: Owner, in sharedWithEmails array, or Admin
      allow read: if request.auth != null && (
                    resource.data.ownerId == request.auth.uid ||  // Owner
                    isInSharedList(resource.data) ||               // In shared list
                    isAdmin()                                      // Admin
                  );
      
      // Create: Anyone logged in
      allow create: if request.auth != null;
      
      // Update: Owner, Editor role (accepted), or Admin
      // Also allow shared users to update their own share status (accept/decline) or leave sharing
      // Also allow any accepted share user to update blocks (checklist/todo)
      allow update: if request.auth != null && (
                       request.auth.uid == resource.data.ownerId ||  // Owner
                       isAdmin() ||                                   // Admin
                       hasAcceptedEditorAccess(resource.data) ||      // Editor role (accepted)
                       // Allow any shared user to update shares and sharedWithEmails (accept/decline/leave)
                       (isInSharedList(resource.data) &&
                        request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['shares', 'sharedWithEmails'])) ||
                       // Allow any accepted shared user to update blocks and updatedAt (checklist/todo)
                       (hasAcceptedShareAccess(resource.data) &&
                        request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['blocks', 'updatedAt']))
                     );
      
      // Delete: Owner or Admin only
      allow delete: if request.auth != null && 
                       (request.auth.uid == resource.data.ownerId || isAdmin());
    }
  }
}
